# Production Environment Variables Template
# Copy this to .env.production.local and fill in your values

# ===== DATABASE CONFIGURATION =====
# Replace with your PostgreSQL connection string
# Examples:
# Supabase: postgresql://user:password@host:5432/database
# Neon: postgresql://user:password@host:5432/database
DATABASE_URL="your_postgresql_connection_string"

# ===== AUTHENTICATION CONFIGURATION =====
# Your deployed app URL
NEXTAUTH_URL="https://your-app.vercel.app"

# Generate a secure random string (32+ characters)
# Use: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secure-random-secret-key-32-chars-minimum"

# ===== APPLICATION CONFIGURATION =====
NODE_ENV=production
PORT=3000

# ===== OPTIONAL: ANALYTICS =====
# Vercel Analytics (if using)
# VERCEL_ANALYTICS_ID="your-vercel-analytics-id"
