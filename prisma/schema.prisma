datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   // 'ADMIN', 'STAFF'
  createdAt DateTime @default(now())
  orders    Order[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   @default("staff")
  joinDate  DateTime @default(now())
  status    String   @default("active") // 'active', 'inactive'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  sku         String?     // Custom SKU for toy store (e.g., Funko Pop numbers)
  description String?
  price       Float
  stock       Int         @default(0) // Add stock field back for backward compatibility
  cabinet     String      @default("main") // Add cabinet field for multi-cabinet support
  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  stockBatches StockBatch[] // Relationship to stock batches
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model StockBatch {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  costPerUnit Float?    // Optional cost tracking
  sellingPrice Float?   // Batch-specific selling price
  batchDate   DateTime  @default(now()) // When this batch was added
  expiryDate  DateTime? // Optional expiry date for perishable items
  cabinet     String
  status      String    @default("on-shelf") // "on-shelf", "in-storage", "reserved", "damaged", "sold-out"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId, batchDate])
  @@index([productId, cabinet])
  @@index([productId, status])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
}

model Order {
  id        Int         @id @default(autoincrement())
  user      User        @relation(fields: [userId], references: [id])
  userId    Int
  items     OrderItem[]
  total     Float
  status    String      // 'PENDING', 'PAID', 'CANCELLED'
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Float
}

model Sale {
  id            String     @id @default(uuid())
  date          DateTime   @default(now())
  items         SaleItem[]
  amount        Float
  paymentMethod String
  staffName     String
  cabinet       String
  soldAt        String     // 'online' or 'physical'
  referenceNumber String?   // Optional reference number for QRPH payments
  archived      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId      String
  productName String
  category    String
  quantity    Int
  price       Float
  unitCost    Float    @default(0) // Exact acquired cost at the moment of sale
}